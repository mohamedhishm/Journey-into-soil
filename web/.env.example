# Optional API Base URL
# - Leave empty (default) if deploying frontend + API behind the same reverse proxy (e.g. Docker Nginx / Cloudflare Tunnel)
# - Set to full URL if hosting frontend separately (e.g. Vercel, Netlify) pointing to your backend:
#   VITE_API_BASE_URL=https://api.yourdomain.com
VITE_API_BASE_URL=
