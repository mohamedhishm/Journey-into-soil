# Copy to .env (never commit .env)
DATABASE_URL=sqlite:////srv/data/app.db
KNOWLEDGE_DIR=/srv/knowledge
CONTRACTS_DIR=/srv/contracts
PACKS_DIR=/srv/data/packs
# CORS origins for API: comma-separated list of allowed origins
# - Local dev: http://localhost:5173
# - Split production (e.g. Vercel frontend): https://your-site.vercel.app,http://localhost:5173
# - Unified Docker reverse-proxy (single domain): not strictly required if served on same domain, but harmless
CORS_ORIGINS=http://localhost:5173

# Google OAuth 2.0 (Google Cloud Console -> APIs & Services -> Credentials)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# The callback URI configured in Google Cloud Console
# - Local dev: http://localhost:5173
# - Production: https://yourdomain.com (or https://your-site.vercel.app)
GOOGLE_REDIRECT_URI=http://localhost:5173
AUTH_SECRET_KEY=journey-into-the-soil-secret-key-2026

# Meteomatics Weather & Soil API (NASA Space Apps Global Collaborator)
METEOMATICS_USERNAME=
METEOMATICS_PASSWORD=

# Cloudflare Tunnel token (for live HTTPS via Option 2)
CLOUDFLARE_TUNNEL_TOKEN=
# Earthdata (only needed on the laptop that runs pipelines/, never on the server)
EARTHDATA_USERNAME=
EARTHDATA_PASSWORD=
EARTHDATA_TOKEN=
